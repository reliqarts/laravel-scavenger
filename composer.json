{
  "name": "reliqarts/laravel-scavenger",
  "description": "The most integrated web scraper package for Laravel.",
  "keywords": [
    "scraper",
    "package",
    "generation",
    "laravel",
    "scavenger",
    "seek",
    "content",
    "data",
    "web"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "reliq",
      "email": "reliq@reliqarts.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-dom": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "illuminate/support": "^12.0 || ^13.0",
    "monolog/monolog": "^3.5",
    "symfony/browser-kit": "^7.2 || ^8.0",
    "symfony/css-selector": "^7.2 || ^8.0",
    "symfony/dom-crawler": "^7.2 || ^8.0",
    "symfony/http-client": "^7.2 || ^8.0",
    "symfony/mime": "^7.2 || ^8.0"
  },
  "require-dev": {
    "laravel/pint": "^1.15",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpro/grumphp": "^2.5",
    "phpspec/prophecy-phpunit": "^2.0",
    "phpunit/phpunit": "^11.0",
    "yieldstudio/grumphp-laravel-pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "ReliqArts\\Scavenger\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ReliqArts\\Scavenger\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:ci": "phpunit --colors=auto --coverage-clover=build/coverage.xml",
    "test:unit": "phpunit --testsuite=Unit --coverage-clover=build/coverage.xml",
    "test:integration": "phpunit --testsuite=Integration"
  },
  "config": {
    "allow-plugins": {
      "phpro/grumphp": true
    },
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "ReliqArts\\Scavenger\\ServiceProvider"
      ]
    }
  }
}
